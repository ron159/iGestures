SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0

ARCHS = arm64
EXCLUDED_ARCHS = x86_64

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
DEAD_CODE_STRIPPING = YES

PRODUCT_NAME = iGestures
PRODUCT_BUNDLE_IDENTIFIER = com.ron159.igestures.dev
MARKETING_VERSION = 0.14.0
CURRENT_PROJECT_VERSION = 14

CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = iGestures/Supporting/iGestures.entitlements
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Debug] = YES
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = iGestures
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_NSAppleEventsUsageDescription = Run the AppleScript actions you choose to control apps and system features.
INFOPLIST_KEY_IGesturesUpdateManifestURL = $(IGESTURES_UPDATE_MANIFEST_URL)
INFOPLIST_KEY_IGesturesUpdatePublicKey = $(IGESTURES_UPDATE_PUBLIC_KEY)

// Optional update feeds can inject an HTTPS manifest URL and Ed25519 key.
IGESTURES_UPDATE_MANIFEST_URL =
IGESTURES_UPDATE_PUBLIC_KEY =
