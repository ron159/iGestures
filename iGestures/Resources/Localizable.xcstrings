          }
        }
      }
    },
    "iGestures observes the configured mouse button and posts only the action you choose. Gesture paths stay on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iGestures 仅观察已配置的鼠标按键，并只发送您选择的动作。手势轨迹始终保留在这台 Mac 上。"
          }
        }
      }
    },
    "macOS shows the permission prompt only after you choose Grant Access.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在您选择“授予访问权限”后，macOS 才会显示权限提示。"
          }
        }
      }
    },
    "“%@” matched, but its action failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已匹配“%@”，但动作执行失败。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
